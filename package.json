{
  "name": "strobe-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "pnpm --filter @strobe/native run build:debug",
    "typecheck": "tsc --noEmit -p packages/strobe/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx -e \"import('strobe/runtime').then(m => m.play('examples/phase0-kick.ts'))\"",
    "demo:phase1": "tsx -e \"import('strobe/runtime').then(m => m.play('examples/phase1-kit.ts'))\""
  },
  "dependencies": {
    "strobe": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
